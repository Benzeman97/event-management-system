<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="logFileName">/home/ubuntu/logs/event-management-service-${spring:profiles.active}-%d{yyyy-MM-dd}.log</Property>
    </Properties>

    <Appenders>
        <RollingFile name="RollingFile" fileName="${logFileName}" filePattern="${logFileName}">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="RollingFile"/>
        </Root>
    </Loggers>
</Configuration>
